.env
.env.1
.env.development.local
.env.test.local
.env.production.local
.functions_cache/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pylint.d/
.docker/
.dockerignore
.dockerlayernotify
*.pyc
*.pyo
*.pyd

# --- Node.js / Frontend ---
node_modules/
.npm
.eslintcache
.stylelint
.prettier_cache
.cache
.DS_Store
