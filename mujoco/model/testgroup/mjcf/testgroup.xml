<mujoco model="testgroup">
   <compiler angle="radian" autolimits="true" eulerseq="zyx"/>
  <!-- <compiler angle="radian" autolimits="true" eulerseq="zyx"/> -->

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>

    <mesh name="base_link" content_type="model/stl" file="D:\android_manager\mujoco\model\testgroup\meshes\base_link.STL"/>
    <mesh name="roller1_link" content_type="model/stl" file="D:\android_manager\mujoco\model\testgroup\meshes\roller1_link.STL"/>
  </asset>

  <default>
    <!-- 默认damping 摩擦力 ，默认 actuatorfrcrange 扭力 -->
    <joint damping=".03" actuatorfrcrange="-0.5 0.5"/>

  </default>
  <worldbody>

    <geom type="plane" size="3 3 .01" material="grid"/>

    <body name="base_link" pos="0 0 0.64" quat="0 0.7071 0.7071 0">
      <inertial pos="-0.056985 0.2 0" quat="0 0.707107 0 0.707107" mass="0.32861" diaginertia="0.000401687 0.000387927 2.32267e-05"/>
      <joint name="floating_base_joint" type="free"/>
      <geom pos="0 0 0" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" group="1" rgba="1 1 1 1" density="0" mesh="base_link"/>
      <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="1 1 1 1" mesh="base_link"/>
      <body name="roller1_link" pos="-0.25 0.2 0.05">
        <inertial pos="-0.16993 -0.0023717 0.05" quat="-0.00493435 0.70709 0.00493435 0.70709" mass="0.37322" diaginertia="0.000101658 9.78227e-05 3.08429e-05"/>
        <joint name="roller1_joint" range="-1 1" actuatorfrcrange="-200 200"/>
        <geom pos="0 0 0" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0" group="1" rgba="1 1 1 1" density="0" mesh="roller1_link"/>
        <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="1 1 1 1" mesh="roller1_link"/>
      </body>
    </body>
  </worldbody>
  <actuator>
      <!-- 为所有 1 个关节建立独立的电机驱动 -->
      <motor name="right_leg_roll_motor" joint="roller1_joint" ctrlrange="-1 1"/>
  </actuator>

  <sensor>
      <!-- 为所有 1 个关节建立独立的力/位置传感器反馈 -->
      <jointactuatorfrc name="right_leg_roll_motor_sensor" joint="roller1_joint"/>
  </sensor>

</mujoco>
